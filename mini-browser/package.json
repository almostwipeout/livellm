{
  "name": "quad-browser",
  "version": "1.0.0",
  "description": "4 LLMs in one window - Claude, ChatGPT, Gemini, Grok",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "keywords": ["electron", "browser", "llm", "ai"],
  "author": "SHUHEI",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.quadbrowser.app",
    "productName": "Quad Browser",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
